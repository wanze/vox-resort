{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vox-resort",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  // Only the analytics endpoint runs the Worker; the game itself stays free, unmetered assets,
  // so even a Worker over its daily limit leaves the game playable.
  "assets": { "directory": "./dist", "run_worker_first": ["/e"] },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "vox_resort" }],
  // Per IP and Cloudflare location. A visit sends a beacon each time its tab is hidden, so even a
  // whole school behind one address stays well under.
  "ratelimits": [
    { "name": "EVENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  // Apex only: saves live in origin-scoped storage, so www should redirect here, not serve a copy.
  "routes": [{ "pattern": "vox-resort.com", "custom_domain": true }],
}
