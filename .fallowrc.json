{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/main.tsx",
    "src/app/compare.tsx",
    "src/app/soundBoard.tsx",
    "src/features/voxel-world/adapters/meshWorker.ts",
    "src/features/resort-prep/adapters/prepWorker.ts",
    "scripts/simReport.test.ts"
  ],
  "ignorePatterns": [".smoke/**", "voxel-gen/out/**"],
  "ignoreDependencies": ["@fontsource/jersey-15"],
  "health": {
    "ignore": [
      "voxel-gen/models/**",
      "voxel-gen/variants/**",
      "voxel-gen/mosaics/styles/**",
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "duplicates": {
    "ignore": ["voxel-gen/models/**", "voxel-gen/variants/**", "voxel-gen/mosaics/styles/**"]
  },
  "boundaries": {
    "zones": [
      { "name": "domain", "patterns": ["src/features/*/domain/**"] },
      { "name": "adapters", "patterns": ["src/features/*/adapters/**"] },
      { "name": "components", "patterns": ["src/features/*/components/**"] },
      { "name": "app", "patterns": ["src/app/**", "src/main.tsx"] },
      { "name": "models", "patterns": ["voxel-gen/**"] },
      { "name": "sounds", "patterns": ["sounds/**"] }
    ],
    "rules": [
      { "from": "domain", "allow": ["domain", "models", "sounds"] },
      { "from": "adapters", "allow": ["domain", "adapters", "models", "sounds"] },
      { "from": "components", "allow": ["domain", "components"] },
      { "from": "app", "allow": ["domain", "adapters", "components", "app", "models", "sounds"] },
      { "from": "models", "allow": ["models"] },
      { "from": "sounds", "allow": ["sounds"], "allowTypeOnly": ["domain"] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "scripts/**",
        "vite.config.ts",
        "index.html",
        "compare.html",
        "sounds.html"
      ]
    }
  }
}
