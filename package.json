{
  "name": "vox-resort",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node voxel-gen/preview.ts && tsc --noEmit && vite build && node scripts/check-precache.ts",
    "preview": "node voxel-gen/preview.ts",
    "preview:dist": "vite preview",
    "bench": "node scripts/bench.ts",
    "sounds:fetch": "node scripts/fetch-sounds.ts",
    "sim:report": "vitest run --config scripts/simReport.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && node scripts/check-comments.ts && node scripts/check-sounds.ts",
    "lint:fix": "oxlint --fix",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --base HEAD",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@amodx/binary": "0.0.20",
    "@amodx/math": "0.0.18",
    "@amodx/threads": "0.0.35",
    "@divinevoxel/vlox": "0.0.85",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/jersey-15": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "fallow": "^3.22.0",
    "oxc-parser": "^0.151.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
